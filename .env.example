# Salin ke .env lalu sesuaikan. .env sudah diabaikan oleh .gitignore.
# Semua nilai di bawah adalah default untuk pengembangan lokal.

# --- Lingkungan -------------------------------------------------------------
# "development" (default) atau "production". Mode produksi menyalakan pengaman
# wajib: COOKIE_SECURE=1, DATABASE_URL terisi, rate limit aktif, akun demo mati.
APP_ENV=development

# --- Database dan unggahan --------------------------------------------------
# Default: data/app.db di dalam folder proyek.
DATABASE_URL=sqlite:///data/app.db
# Default: data/uploads di dalam folder proyek.
UPLOAD_DIR=data/uploads

# --- Akun contoh ------------------------------------------------------------
# 1 membuat admin@example.com / Admin123! saat database pertama kali diisi.
# Jangan pernah aktif di produksi.
ALLOW_DEMO_ACCOUNTS=0

# --- Cookie sesi ------------------------------------------------------------
# Wajib 1 di produksi. Harus 1 juga bila COOKIE_SAMESITE=none.
COOKIE_SECURE=0
# lax | strict | none
COOKIE_SAMESITE=lax
SESSION_COOKIE_DAYS=14

# --- Pembatas laju per alamat IP --------------------------------------------
RATE_LIMIT_ENABLED=1
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_RATING=20
RATE_LIMIT_WINDOW_MINUTES=15

# --- Di belakang reverse proxy ----------------------------------------------
# Daftar IP proxy yang dipercaya, dipisah koma. Kosong berarti X-Forwarded-For
# diabaikan dan semua pengunjung berbagi satu bucket pembatas laju.
TRUSTED_PROXIES=

# --- Server (hanya untuk python app/main.py) ------------------------------
# Jalur uvicorn CLI memakai --host/--port sendiri dan mengabaikan ini.
HOST=127.0.0.1
PORT=8001

# --- Lain-lain --------------------------------------------------------------
# Foto usulan yang tidak pernah ditinjau dihapus setelah sekian hari.
STAGED_PHOTO_TTL_DAYS=30
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
